# STONE OS (rebuild) - base image for STONE MACHINE (AMD BC-250: 8 CPU cores, 40 GPU CU).
# Derived from Bazzite (Steam Game Mode variant) with the ublue-os/image-template method: one
# Containerfile, scripts run from a build context that never lands in the image, and
# `bootc container lint` at the end.
#
# Build from the repository root (the context is the whole tree):
#   podman build -f image/Containerfile --build-arg BASE_IMAGE=<image@digest> .
# scripts/build-local.sh and the build-image workflow pass the pinned base from image/config/build.env.
ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck:stable-44@sha256:278941ea67603e24e24ff18e8c418b91f2f326fffd3d24edcff9779f36fbdf4e

FROM scratch AS ctx
COPY image/build_files /
COPY image/config/build.env /build.env
COPY system /system_files
COPY services /services
COPY apps /apps
COPY modules /modules
COPY VERSION /VERSION

FROM ${BASE_IMAGE} AS base

## BC-250 40 CU: amdgpu rebuilt for the base image's exact kernel with the unlock option
## (build_files/cu40/build-amdgpu.sh, unchanged from rc23). 40 CU is the reference configuration
## (D-16), so build.sh fails the image when this stage gives no module.
FROM registry.fedoraproject.org/fedora:44 AS cu40
RUN dnf -y install --setopt=install_weak_deps=False \
        gcc make flex bison bc perl python3 diffutils findutils elfutils-libelf-devel \
        openssl openssl-devel dwarves git-core kmod binutils xz \
        glslang vulkan-loader-devel vulkan-headers \
    && dnf clean all
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=base,source=/usr,target=/base-usr \
    mkdir -p /usr/src/kernels && cp -a /base-usr/src/kernels/. /usr/src/kernels/ 2>/dev/null; \
    bash /ctx/cu40/build-amdgpu.sh

FROM base

ARG BASE_IMAGE
ARG BASE_DIGEST=""
ARG STONE_COMMIT="unknown"
ARG STONE_BUILD_DATE="unknown"
ARG STONE_CHANNEL="dev"

### MODIFICATIONS
## Every system change is made here, by build.sh; never by hand on an installed console.
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=bind,from=cu40,source=/out,target=/cu40 \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    BASE_IMAGE="${BASE_IMAGE}" BASE_DIGEST="${BASE_DIGEST}" STONE_COMMIT="${STONE_COMMIT}" \
    STONE_BUILD_DATE="${STONE_BUILD_DATE}" STONE_CHANNEL="${STONE_CHANNEL}" \
    /ctx/build.sh

LABEL org.opencontainers.image.title="stone-os-rebuild" \
      org.opencontainers.image.description="STONE OS rebuild (F0 base image) for STONE MACHINE, AMD BC-250" \
      org.opencontainers.image.revision="${STONE_COMMIT}" \
      org.opencontainers.image.created="${STONE_BUILD_DATE}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.licenses="Apache-2.0"

### LINTING
## Verify the final image is a valid bootc system.
RUN bootc container lint
