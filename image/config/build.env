# Build parameters shared by scripts/build-local.sh and the GitHub workflows.
# Nothing here is a secret. The GitHub owner is never written here: workflows use
# ${GITHUB_REPOSITORY_OWNER}, local builds use the --owner argument.

# F0-A: a name of its own, so a console that follows ghcr.io/<owner>/stone-os (rc23) never
# updates itself to a rebuild image that does not have stoned or STONE Home yet.
IMAGE_NAME=stone-os-rebuild

# Bazzite with Steam Game Mode (AMD), Fedora 44. Pinned to the base every board measurement of
# rc14-rc23 was taken on (Bazzite 44.20261026.0, kernel 7.2.11-ogc4.1; build-metadata of those
# releases, 02_AUDIT/evidencia). Moving to a newer base is a deliberate change: update the digest,
# pass CI (the 40 CU module must still build) and repeat the board gate.
BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck
BASE_TAG=stable-44
BASE_DIGEST=sha256:278941ea67603e24e24ff18e8c418b91f2f326fffd3d24edcff9779f36fbdf4e

# GPU governor (cyan-skillfish-governor-smu, COPR filippor/bazzite), pinned to the version every
# board measurement used (R-03; COPR build 11067195, fedora-44-x86_64). v0.4.15 (rc23) is not
# adopted until its D-Bus contract is checked and the board tests 0, 5 and 28 are repeated.
GOVERNOR_COPR=filippor/bazzite
# version-release exactly as rpm reports it (STONE_GOVERNOR_VERSION of rc14-rc16).
GOVERNOR_VERSION=v0.4.14-1.20260619120402457887.update.deps.3.g14080b4.fc44

# Reference hardware of STONE MACHINE (D-16). Not limits: recorded in stone-release so that
# later phases can compare what they detect with what the console is meant to be.
STONE_REFERENCE_CPU_CORES=8
STONE_REFERENCE_GPU_CU=40

# Installer builder (bootc-image-builder). Its digest is recorded in the installer build log.
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest

# ISO split size for GitHub Releases (each release file must stay under 2 GiB).
ISO_PART_SIZE=1900M
