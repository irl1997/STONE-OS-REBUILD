[Unit]
Description=STONE session boot guard (back to Bazzite's Game Mode after two failed STONE boots)
Documentation=file:///usr/lib/stone/stone_home/guard.py
# After Bazzite writes its own autologin files, before SDDM reads them.
After=local-fs.target bazzite-autologin.service
Before=display-manager.service
ConditionPathExists=/usr/share/wayland-sessions/gamescope-session-stone.desktop

[Service]
Type=oneshot
ExecStart=/usr/libexec/stone/stone-session-guard

[Install]
WantedBy=multi-user.target
