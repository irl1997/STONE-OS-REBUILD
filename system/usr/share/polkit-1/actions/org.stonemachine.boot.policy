<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>STONE MACHINE</vendor>
  <!-- STONE Home's Energía → Opciones de arranque → Versión anterior: the next boot starts the
       previous STONE OS image (bootc rollback). Only that exact command line, only to the console
       administrator (rules.d/50-stone.rules); anything else asks for the password. -->
  <action id="org.stonemachine.boot.rollback">
    <description>Arrancar la versión anterior de STONE OS</description>
    <message>Cambiar la versión de arranque requiere estar frente a la consola</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/bootc</annotate>
  </action>
</policyconfig>
