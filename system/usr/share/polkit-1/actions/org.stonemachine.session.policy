<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>STONE MACHINE</vendor>
  <!-- STONE Home's "Escritorio" and the desktop's "Volver a STONE": pick the session of the next
       login only. The person at the console is allowed; in the STONE session Home runs outside
       the logind session, so rules.d/50-stone.rules allows the console administrator (wheel). -->
  <action id="org.stonemachine.session.select">
    <description>Cambiar entre STONE y el escritorio</description>
    <message>Cambiar de sesión requiere estar frente a la consola</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/stone/stone-session-select</annotate>
  </action>
</policyconfig>
