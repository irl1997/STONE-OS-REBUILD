// STONE OS: the console administrator may change performance profiles from a desktop session or
// SSH without a password prompt. The STONE plugin's backend runs as root and does not need this.
// stoned still checks every value against the governor's factory range.
polkit.addRule(function (action, subject) {
    if ((action.id == "org.stonemachine.performance.change" ||
         action.id == "org.stonemachine.performance.tune") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
